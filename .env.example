# --- Database -----------------------------------------------------------
# Local Postgres via `docker compose up -d` (see docker-compose.yml, port 5433
# to avoid clashing with a native Postgres install) or a managed provider.
# Use the same password in POSTGRES_PASSWORD (read by docker-compose.yml).
POSTGRES_PASSWORD="conectax"
DATABASE_URL="postgresql://conectax:conectax@localhost:5433/conectax?schema=public"
# Direct (non-pooled) connection used by migrations. Locally, same as DATABASE_URL;
# on Vercel the Neon integration creates it automatically.
DATABASE_URL_UNPOOLED="postgresql://conectax:conectax@localhost:5433/conectax?schema=public"

# --- Seed users (npm run db:seed) — at least 12 characters ------------------
# Use a real inbox for the admin in production (it receives password resets).
SEED_ADMIN_EMAIL="admin@conectax.local"
SEED_ADMIN_PASSWORD=""
SEED_USER_PASSWORD=""
# "false" skips the demo user, posts, comments and forum topic (use in production).
SEED_DEMO="true"

# --- Auth.js / NextAuth ---------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# "true" only when a reverse proxy you control sets X-Forwarded-For
# (on Vercel the platform's own IP headers are used automatically).
TRUST_PROXY="false"

# --- Rate limiting (Upstash Redis) ----------------------------------------
# Required in production on serverless: in-memory limits don't hold across
# instances. The Vercel Upstash integration may name them KV_REST_API_URL/TOKEN —
# both names work. Leave blank locally to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OAuth providers (optional, architecture is ready — leave blank to disable)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Email (password reset) ----------------------------------------------
# Any SMTP provider (e.g. Resend, Mailtrap for dev, SES, Postmark).
# Resend: host smtp.resend.com, port 465, user "resend", password = API key.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="ConectaX <no-reply@conectax.local>"

# --- File storage ---------------------------------------------------------
# Upload order: S3 (if configured) → Vercel Blob (if token set) → local disk (dev only).
# Vercel Blob: created by Storage → Blob in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# S3-compatible (optional)
S3_REGION="auto"
S3_ENDPOINT=""
S3_BUCKET="conectax-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
